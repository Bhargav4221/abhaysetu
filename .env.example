# AbhaySetu environment — copy to .env and fill real values.
# Never commit secrets.

APP_NAME=AbhaySetu
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Public API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL (cloud / production backend)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=abhaysetu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abhaysetu

# Redis (optional in development; SOS still works if Redis is down)
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Hub
HUB_ID=hub-dev-001
HUB_NAME=Development Emergency Hub
HUB_SQLITE_PATH=./data/hub.sqlite3
CLOUD_SYNC_URL=http://localhost:8000
HUB_SYNC_INTERVAL_SECONDS=15

# Auth bootstrap (first admin). Leave empty after initial setup.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=AbhaySetu Admin

# Rate limiting
SOS_RATE_LIMIT_PER_DEVICE_PER_HOUR=20
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=10

# Communication policy (comma-separated adapter ids)
COMMUNICATION_ORDER=internet,local_network,peer_relay,radio,satellite,store_and_forward

# Integrations that require external hardware/services.
# These stay disabled until a real adapter is configured.
RADIO_GATEWAY_ENABLED=false
SATELLITE_ADAPTER_ENABLED=false
SATELLITE_PROVIDER=
# Development test adapters MUST not be treated as real delivery.
ALLOW_SIMULATED_ADAPTERS=false

# Optional online AI (assistive only). If unset, local rules/keywords are used.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Map
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_DATA_UPDATED_AT=

# Data
SEED_SAMPLE_DATA=false
DATA_RETENTION_DAYS=365

# TLS (production)
TLS_CERT_PATH=
TLS_KEY_PATH=
